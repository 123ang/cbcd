# Export these variables before local startup, or copy equivalent values into
# the systemd EnvironmentFile described in DEPLOY_VPS.md.
CBCD_API_KEY=replace-with-a-long-random-operator-key
CBCD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://cbcd.suntzutechnologies.com
CBCD_TRUSTED_PROXY_IPS=127.0.0.1,::1
CBCD_COMPUTE_RATE_LIMIT=30
CBCD_UPLOAD_RATE_LIMIT=6
CBCD_WRITE_RATE_LIMIT=10
CBCD_MAX_QLEARNING_CELLS=2500

# Q-tables stay in memory by default. Enable only for controlled experiments.
CBCD_PERSIST_Q_TABLES=false
CBCD_Q_TABLE_MAX_FILES=50
